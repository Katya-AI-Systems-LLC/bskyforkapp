# SkyConnect Environment Configuration
# Copy this file to .env and update with your values

# App Configuration
EXPO_PUBLIC_ENV=production
EXPO_PUBLIC_RELEASE_VERSION=1.0.0
EXPO_PUBLIC_BUNDLE_IDENTIFIER=app.skyconnect
EXPO_PUBLIC_BUNDLE_DATE=2025013100

# Logging
EXPO_PUBLIC_LOG_LEVEL=info
EXPO_PUBLIC_LOG_DEBUG=

# API Services (using Bluesky infrastructure as requested)
EXPO_PUBLIC_BLUESKY_PROXY_DID=did:web:api.bsky.app
EXPO_PUBLIC_CHAT_PROXY_DID=did:web:api.bsky.chat

# Analytics and Monitoring
EXPO_PUBLIC_METRICS_API_HOST=https://events.bsky.app
EXPO_PUBLIC_GROWTHBOOK_API_HOST=https://events.bsky.app/gb
EXPO_PUBLIC_GROWTHBOOK_CLIENT_KEY=skyconnect-sdk-key

# Error Tracking
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_BITDRIFT_API_KEY=

# Google Services
EXPO_PUBLIC_GOOGLE_PROJECT_ID=

# Development URLs (optional)
GEOLOCATION_DEV_URL=
LIVE_EVENTS_DEV_URL=

# Build Configuration
SENTRY_AUTH_TOKEN=
EAS_PROJECT_ID=55bd077a-d905-4184-9c7f-94789ba0f302

# SkyConnect Specific
SKYCONNECT_SUPPORT_EMAIL=support@skyconnect.app
SKYCONNECT_PRIVACY_URL=https://skyconnect.app/privacy
SKYCONNECT_TERMS_URL=https://skyconnect.app/terms
SKYCONNECT_HELP_URL=https://skyconnect.app/help
